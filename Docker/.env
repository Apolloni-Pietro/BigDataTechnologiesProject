# Copy this file to .env and fill in the values.
# Never commit .env — it is in .gitignore.

# Your GitHub personal access token (public_repo scope is enough).
# Without this the ingestion worker runs in FAKE DATA mode only.
GITHUB_TOKEN=

# Earliest GH Archive date to backfill from. Use a recent date to
# limit initial data volume. Format: YYYY-MM-DD
INGESTION_START_DATE=2024-01-01

# TimescaleDB credentials. Change the password if this machine
# is on a shared network.
POSTGRES_USER=oss
POSTGRES_PASSWORD=changeme
POSTGRES_DB=oss_health

# Maximum RAM Redis may use before evicting old data.
# Reduce to 1gb if your machine has less than 8 GB free for Docker.
REDIS_MAX_MEMORY=2gb

# Copy this file to .env and fill in the values.
# Never commit .env — it is in .gitignore.

# ── MinIO (bronze + silver object storage) ──────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Batch pipeline tuning ───────────────────────────────────────────────────
# Optional one-shot historical replay on first startup (format YYYY-MM-DD-H).
# Leave both empty to only process new hours going forward.
#   e.g. BACKFILL_START=2024-01-01-0  BACKFILL_END=2024-01-01-5
BACKFILL_START=
BACKFILL_END=
# Optional FAST backfill from pre-downloaded monthly Parquet files (produced by
# the repo-root GHArchiveDownload.py). Set to /backfill to ingest the files
# mounted at Docker/../processed_parquet. Takes PRECEDENCE over BACKFILL_START/END.
# Run on a fresh silver bucket (docker compose down -v first). See PARQUET_BACKFILL.md.
BACKFILL_PARQUET_DIR=
# Memory cap for ALL DuckDB work (backfill dedup + gold's 90-day aggregation). Large
# operations spill to disk instead of OOM-killing the container. Keep below the
# Docker VM's RAM, leaving room for the other containers.
DUCKDB_MEMORY_LIMIT=8GB

# ── Replay (process the feed from N years ago) ──────────────────────────────
# Shift the pipeline's "now" back this many years so it fetches/processes the feed
# from N years ago (older GH Archive data carries full PushEvent commit arrays).
# 0 = off. Startup then runs parquet bulk -> hourly tail -> live, all year-shifted.
REPLAY_OFFSET_YEARS=0
# Rolling-window sizes. Defaults are 90/30; widen if replaying a single older month
# so it lands inside the window of the shifted "now".
CONTRIBUTOR_WINDOW_DAYS=90
COMMIT_FREQ_WINDOW_DAYS=30
# Restrict the parquet backfill to specific files, e.g. gh_events_2025-*.parquet.
BACKFILL_PARQUET_GLOB=gh_events_*.parquet

# ── Retention (keeps MinIO from filling up during 24/7 operation) ───────────
# Bronze = transient raw landing zone, pruned aggressively.
# Silver = the history gold aggregates over rolling windows, so it MUST stay
#   >= the largest window (90 days) or metrics degrade at the edge.
BRONZE_RETENTION_DAYS=30
SILVER_RETENTION_DAYS=120
RETENTION_CRON_HOUR=4

# TimescaleDB credentials. Change the password if this machine
# is on a shared network.
POSTGRES_USER=oss
POSTGRES_PASSWORD=changeme
POSTGRES_DB=oss_health

# Maximum RAM Redis may use before evicting old data.
# Reduce to 1gb if your machine has less than 8 GB free for Docker.
REDIS_MAX_MEMORY=2gb

# ── MQTT alerts ─────────────────────────────────────────────────────────────
# Repos whose health_score drops below this threshold trigger an alert published
# to repos/{owner}/{repo}/alerts. Alerts are edge-triggered (fire once on
# crossing, not every cycle the score stays low). Default: 0.4.
MQTT_ALERT_THRESHOLD=0.4
